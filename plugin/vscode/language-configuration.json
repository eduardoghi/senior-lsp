{
    "comments": {
        "blockComment": ["/*", "*/"]
    },
    "brackets": [
        ["{", "}"],
        ["(", ")"],
        ["[", "]"]
    ],
    "autoClosingPairs": [
        { "open": "{", "close": "}" },
        { "open": "(", "close": ")" },
        { "open": "[", "close": "]" },
        { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["(", ")"],
        ["[", "]"],
        ["\"", "\""]
    ],
    "wordPattern": "[A-Za-z_][A-Za-z0-9_]*",
    "indentationRules": {
        "increaseIndentPattern": "^.*(\\{|\\b[Ii][Nn][Ii][Cc][Ii][Oo])\\s*(@[^@]*@\\s*)?$",
        "decreaseIndentPattern": "^\\s*(\\}|[Ff][Ii][Mm]\\b)"
    }
}
