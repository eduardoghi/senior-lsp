{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "senior-lsp.json",
    "description": "Configuração dos diagnósticos do Senior LSP para a pasta do arquivo e as de dentro dela.",
    "type": "object",
    "properties": {
        "diagnostics": {
            "$ref": "#/definitions/diagnosticos"
        },
        "overrides": {
            "type": "array",
            "description": "Níveis por arquivo, na ordem. O último que casa vence.",
            "items": {
                "type": "object",
                "required": [
                    "files"
                ],
                "properties": {
                    "files": {
                        "description": "Glob relativo à pasta do senior-lsp.json, como Modelos/**.",
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "minItems": 1
                            }
                        ]
                    },
                    "diagnostics": {
                        "$ref": "#/definitions/diagnosticos"
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false,
    "definitions": {
        "nivel": {
            "type": "string",
            "enum": [
                "off",
                "hint",
                "info",
                "warning",
                "error"
            ],
            "description": "off esconde o diagnóstico. Os outros níveis trocam a severidade dele."
        },
        "diagnosticos": {
            "type": "object",
            "description": "Nível de cada código de diagnóstico. Os erros de sintaxe (SEN001 a SEN028) não mudam.",
            "properties": {
