{
    "senior-lsp": {
        "command": "${CLAUDE_PLUGIN_ROOT}/server/senior-lsp",
        "extensionToLanguage": {
            ".txt": "plaintext",
            ".json": "json"
        },
        "startupTimeout": 60000,
        "shutdownTimeout": 5000,
        "maxRestarts": 3,
        "env": {
            "SENIOR_LSP_TBS_PRODUCAO": "${user_config.tbs_producao}",
            "SENIOR_LSP_TBS_TESTE": "${user_config.tbs_teste}"
        }
    }
}
